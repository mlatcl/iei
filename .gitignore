_lamd/*.notes.*
_lamd/*.posts.*
_lamd/*.slides.*
_lamd/makefile
_lamd/*.log
_lamd/talk-people.gpp
_lamd/*-e

# Ignore compiled site output
_site/

# Ignore Ruby bundler files
.bundle/
Gemfile.lock

# Ignore by default all hidden files except .gitignore and CI workflows
.*
!.gitignore
!.github/
!.github/**

